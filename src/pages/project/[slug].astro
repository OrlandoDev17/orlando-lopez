---
import Layout from "@/components/layout/Layout.astro";
import Button from "@/components/common/Button.astro";
import ImageCarousel from "@/components/projects/ImageCarousel.astro";
import ProjectMetrics from "@/components/projects/ProjectMetrics.astro";
import BeforeAfter from "@/components/projects/BeforeAfter.astro";
import ProjectChallenges from "@/components/projects/ProjectChallenges.astro";
import ProjectFeatures from "@/components/projects/ProjectFeatures.astro";
import { Icon } from "astro-icon/components";
import { ProjectsData } from "@/constants/projects";

export function getStaticPaths() {
  return ProjectsData.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const metadata = [
  { label: "Rol", value: project.role },
  { label: "Duración", value: project.duracion },
  { label: "Cliente", value: project.client },
];

const demoUrl = project.links.find(l => l.icon.includes('rocket'))?.url;
const githubUrl = project.links.find(l => l.icon.includes('github'))?.url;
---

<Layout title={project.title} description={project.summary}>
  <main class="max-w-7xl mx-auto w-full px-8">
    <!-- Hero: Mockup + Texto + Botones -->
    <section id="project-hero" class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center pt-8">
      <article class="relative order-2 lg:order-1 bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
        <img 
          id="project-hero-image"
          transition:name={`${project.slug}-image`}
          src={project.thumbnail} 
          alt={project.title}
          class="w-full h-auto object-cover"
        >
      </article>
      
      <div class="order-1 lg:order-2 flex flex-col gap-3 justify-center">
        <h1 
          id="project-title"
          transition:name={`${project.slug}-title`}
          class="text-3xl md:text-4xl font-black text-main leading-tight"
        >
          {project.title}
        </h1>
        <p 
          id="project-summary"
          transition:name={`${project.slug}-summary`}
          class="text-sm text-muted leading-snug"
        >
          {project.summary}
        </p>
        <div id="project-cta" class="flex flex-wrap gap-3 mt-2">
          {demoUrl && (
            <Button href={demoUrl} variant="primary" className="text-sm">
              <Icon class="size-4" name="lucide:rocket" />
              Explorar proyecto
            </Button>
          )}
          {githubUrl && (
            <Button href={githubUrl} variant="secondary" className="text-sm">
              <Icon class="size-4" name="simple-icons:github" />
              Ver código fuente
            </Button>
          )}
        </div>
      </div>
    </section>

    <!-- Metadata: Rol, Duración, Cliente -->
    <section id="project-info" aria-labelledby="project-info-heading" class="py-6">
      <h2 class="sr-only" id="project-info-heading">Información del Proyecto</h2>
      <dl class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {metadata.map((item, index) => (
          <>
            {index > 0 && (
              <div class="w-px h-6 bg-border-subtle hidden sm:block" aria-hidden="true"></div>
            )}
            <div class="project-meta-item flex flex-col items-center gap-0.5">
              <dt class="font-semibold text-xs uppercase tracking-widest text-muted">
                {item.label}
              </dt>
              <dd class="text-lg font-bold text-main">
                {item.value}
              </dd>
            </div>
          </>
        ))}
      </dl>
    </section>

    <!-- Separador -->
    <div class="project-separator border-t border-border-subtle max-w-xs mx-auto" aria-hidden="true"></div>

    <!-- Stack Tecnológico -->
    <section id="project-tech" aria-labelledby="tech-stack-heading" class="py-6">
      <h2 class="sr-only" id="tech-stack-heading">Stack Tecnológico</h2>
      <ul class="flex flex-wrap items-center justify-center gap-2">
        {project.techs.map(({ icon, name }) => (
          <li class="project-tech-item">
            <Icon 
              title={name}
              aria-label={name}
              class="size-12 p-2.5 rounded-lg bg-bg-main border border-border-subtle 
                     hover:bg-main hover:text-white hover:border-main
                     transition-all duration-300 cursor-default"
              name={icon}
            />
          </li>
        ))}
      </ul>
    </section>

    <!-- Separador -->
    <div class="project-separator border-t border-border-subtle max-w-xs mx-auto" aria-hidden="true"></div>

    <!-- Detalles del Proyecto -->
    <section id="project-details" aria-labelledby="project-details-heading" class="py-8 space-y-8">
      <h2 class="sr-only" id="project-details-heading">Detalles del Proyecto</h2>

      <!-- Impacto -->
      <div class="detail-block">
        <ProjectMetrics metrics={project.metrics} />
      </div>

      <!-- Antes vs Después -->
      <div class="detail-block">
        <BeforeAfter before={project.before} after={project.after} />
      </div>

      <!-- Resolución de Retos -->
      <div class="detail-block">
        <ProjectChallenges challenges={project.challenges} />
      </div>

      <!-- Características -->
      <div class="detail-block">
        <ProjectFeatures features={project.features} />
      </div>

      <!-- Separador -->
      <div class="project-separator border-t border-border-subtle max-w-xs mx-auto" aria-hidden="true"></div>

      <!-- Galería de Imágenes -->
      <div class="detail-block">
        <ImageCarousel images={project.images} alt={project.title} device={project.device} />
      </div>

      <!-- Separador -->
      <div class="project-separator border-t border-border-subtle max-w-xs mx-auto" aria-hidden="true"></div>

      <!-- Volver -->
      <nav class="detail-block text-center" aria-label="Navegación del proyecto">
        <a href="/#projects" class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary-600 transition-colors duration-300">
          <Icon class="size-4" name="lucide:arrow-left" aria-hidden="true" />
          Volver a proyectos
        </a>
      </nav>
    </section>
  </main>
</Layout>

<script>
  import { animateFrom, splitTextReveal } from "gsap-presets-kit";
  import { gsap, createSectionTimeline } from "@/utils/gsap";

  const initProjectAnimations = () => {
    const hero = document.getElementById("project-hero");
    if (!hero || hero.dataset.animated === "true") return;
    hero.dataset.animated = "true";

    // Hero: entrada al cargar la vista
    const heroTl = gsap.timeline({ defaults: { ease: "power3.out" } });

    animateFrom("#project-hero-image", {
      opacity: 0,
      scale: 0.94,
      y: 30,
      duration: 0.7,
      timeline: heroTl,
      scroll: false,
    });

    splitTextReveal("#project-title", {
      type: "words",
      opacity: 0,
      y: 30,
      stagger: 0.08,
      duration: 0.5,
      timeline: heroTl,
      position: "-=0.45",
      scroll: false,
    });

    animateFrom("#project-summary", {
      opacity: 0,
      y: 20,
      duration: 0.5,
      timeline: heroTl,
      position: "-=0.3",
      scroll: false,
    });

    animateFrom("#project-cta a", {
      opacity: 0,
      y: 16,
      stagger: 0.1,
      duration: 0.4,
      ease: "back.out(1.6)",
      timeline: heroTl,
      position: "-=0.25",
      scroll: false,
    });

    // Metadata: rol, duración y cliente
    const metaTl = createSectionTimeline("#project-info");
    animateFrom(".project-meta-item", {
      opacity: 0,
      y: 20,
      duration: 0.4,
      stagger: 0.1,
      timeline: metaTl,
      scroll: false,
    });

    // Stack tecnológico
    const techTl = createSectionTimeline("#project-tech");
    animateFrom(".project-tech-item", {
      opacity: 0,
      scale: 0.8,
      y: 12,
      duration: 0.35,
      stagger: 0.05,
      ease: "back.out(1.7)",
      timeline: techTl,
      scroll: false,
    });

    // Bloques de detalle con entrada al hacer scroll
    document.querySelectorAll<HTMLElement>(".detail-block").forEach((block) => {
      const tl = createSectionTimeline(block);

      animateFrom(block, {
        opacity: 0,
        y: 40,
        duration: 0.6,
        timeline: tl,
        scroll: false,
      });

      const inner = block.querySelectorAll(
        ".metric-card, .challenge-card, .feature-item, .before-after-card",
      );

      if (inner.length) {
        animateFrom(inner, {
          opacity: 0,
          y: 24,
          duration: 0.45,
          stagger: 0.12,
          timeline: tl,
          position: "-=0.3",
          scroll: false,
        });
      }
    });

    // Separadores
    document.querySelectorAll<HTMLElement>(".project-separator").forEach((separator) => {
      const tl = createSectionTimeline(separator, { start: "top 92%" });
      tl.from(separator, {
        scaleX: 0,
        transformOrigin: "center center",
        duration: 0.5,
        ease: "power2.out",
      });
    });
  };

  document.addEventListener("astro:page-load", initProjectAnimations);
</script>
