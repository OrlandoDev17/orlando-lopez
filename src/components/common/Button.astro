---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> &
	HTMLAttributes<"button"> & {
		href?: string;
		variant?: "primary" | "secondary" | "muted";
		className?: string;
	};

const { href, variant = "primary", className = "" } = Astro.props;

const baseStyles =
	"inline-flex items-center justify-center gap-2 rounded-lg font-semibold px-5 py-2.5 hover:-translate-y-1 transition-all duration-300 cursor-pointer no-underline";

const variantStyles = {
	primary: "shadow-lg shadow-primary-600/50 border-2 border-transparent bg-primary-500 text-white hover:bg-primary-600 hover:shadow-primary-600/70",
	secondary: "shadow-lg shadow-secondary-600/50 border-2 border-secondary-500 text-secondary-600 hover:bg-secondary-500 hover:text-white hover:shadow-secondary-600/70",
	muted: "shadow-lg shadow-main/40 border-2 border-transparent bg-main text-white hover:bg-main/80 hover:shadow-main/60",
};

const classes = `${baseStyles} ${variantStyles[variant]} ${className}`.trim();
---

{href ? (
	<a href={href} class={classes}>
		<slot />
	</a>
) : (
	<button type="button" class={classes}>
		<slot />
	</button>
)}
