---
import { Icon } from "astro-icon/components";

interface Props {
  features: string[];
}

const { features } = Astro.props;
---

<section aria-labelledby="features-heading">
  <h2 id="features-heading" class="text-xs font-semibold uppercase tracking-widest text-muted mb-4 flex items-center gap-2">
    <Icon class="size-4 text-primary-500" name="lucide:layers" aria-hidden="true" />
    Características
  </h2>
  <ul class="space-y-2">
    {features.map((feature, i) => {
      const [title, ...desc] = feature.split(':');
      return (
        <li class="flex items-start gap-3 group">
          <span class="size-6 rounded-full bg-primary-500/10 flex items-center justify-center shrink-0 mt-0.5">
            <span class="text-[10px] font-bold text-primary-600">{String(i + 1).padStart(2, '0')}</span>
          </span>
          <div>
            <span class="text-sm font-semibold text-main">{title}</span>
            {desc.length > 0 && (
              <span class="text-xs text-muted leading-snug block">{desc.join(':')}</span>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</section>
