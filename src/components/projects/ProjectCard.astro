---
import { ArrowRight } from '@lucide/astro';
import { Icon } from 'astro-icon/components';
import type { Project } from '@/constants/projects';

type Props = Project;

const { slug, thumbnail, title, role, summary, links, techs } = Astro.props;

const getLinkLabel = (icon: string) =>
  icon.includes("github")
    ? `Ver el código fuente de ${title} en GitHub`
    : `Ver la demostración de ${title}`;
---

<article class="grid grid-cols-1 md:grid-cols-5 place-items-center w-full bg-white shadow-md rounded-xl overflow-hidden 2xl:min-h-72 
  hover:shadow-xl transition-all duration-300 group/card">
  <div class="col-span-1 md:col-span-2 w-full h-full overflow-hidden aspect-video md:aspect-auto">
    <img 
      transition:name={`${slug}-image`} 
      class="block w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-102" 
      src={thumbnail} 
      alt={`Proyecto: ${title}`}
      width={1920}
      height={1080}
      loading="lazy"
      decoding="async"
    >
  </div>
  <div class="col-span-1 md:col-span-3 flex flex-col gap-2 2xl:gap-4 w-full p-6">
    <div class="flex items-center justify-between">
      <h3 transition:name={`${slug}-title`} class="text-2xl font-black">{title}</h3>
      <ul class="flex items-center gap-2">
        {links.map(({icon, url}) => (
          <li>
            <a href={url} aria-label={getLinkLabel(icon)}>
              <Icon aria-hidden="true" class="size-10 p-2 rounded-xl border-2 border-secondary-700 text-secondary-700 
              hover:bg-secondary-600 hover:text-white transition-all duration-300" name={icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <h4 class="text-lg text-primary-600 font-bold">{role}</h4>
    <p transition:name={`${slug}-summary`} class="text-sm text-muted max-w-2xl">{summary}</p>
    <ul class="flex items-center gap-2 flex-wrap">
      {techs.map(({icon, name}) => (
        <li>
          <Icon title={name} class="size-12 p-3 rounded-xl bg-bg-main hover:bg-main hover:text-white transition-all 
            duration-300" name={icon} />
        </li>
      ))}
    </ul>
    <a 
    class="flex items-center gap-2 px-12 py-3.5 bg-main text-white w-fit rounded-xl font-bold font-heading project-card-btn
    hover:tracking-wide transition-all duration-300 group" 
    href={`/project/${slug}/`}
    aria-label={`Ver más detalles de ${title}`}
    >
      <span class="relative z-1 flex items-center gap-2">Más Detalles <ArrowRight aria-hidden="true" class='size-4 stroke-3 transition-transform duration-300 group-hover:translate-x-1' /></span>
    </a>
  </div>
</article>

<style>
  .project-card-btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .project-card-btn::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 100%;
    background: var(--color-primary-500);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    z-index: 0;
  }

  .project-card-btn:hover::before,
  .project-card-btn:focus-visible::before {
    transform: scaleY(1);
  }
</style>