---
import { Icon } from "astro-icon/components";
import type { Challenge } from "@/constants/projects";

interface Props {
  challenges: Challenge[];
}

const { challenges } = Astro.props;
---

<section aria-labelledby="challenges-heading">
  <h2 id="challenges-heading" class="text-xs font-semibold uppercase tracking-widest text-muted mb-5">
    Resolución de Retos
  </h2>
  <ul class="space-y-4">
    {challenges.map(({ problem, solution, result }) => (
      <li class="bg-white border border-border-subtle rounded-2xl overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-3">
          <div class="p-5 border-b md:border-b-0 md:border-r border-border-subtle">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-muted flex items-center gap-1.5 mb-2">
              <Icon class="size-3.5 text-red-400" name="lucide:alert-circle" aria-hidden="true" />
              Problema
            </span>
            <p class="text-sm text-main leading-snug">{problem}</p>
          </div>
          <div class="p-5 border-b md:border-b-0 md:border-r border-border-subtle bg-primary-500/5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-primary-600 flex items-center gap-1.5 mb-2">
              <Icon class="size-3.5" name="lucide:lightbulb" aria-hidden="true" />
              Solución
            </span>
            <p class="text-sm text-main leading-snug">{solution}</p>
          </div>
          <div class="p-5 bg-secondary-500/5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-secondary-600 flex items-center gap-1.5 mb-2">
              <Icon class="size-3.5" name="lucide:check-circle" aria-hidden="true" />
              Resultado
            </span>
            <p class="text-sm text-main leading-snug">{result}</p>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
