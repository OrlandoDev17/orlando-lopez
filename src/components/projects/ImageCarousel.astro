---
import { Icon } from "astro-icon/components";

interface Props {
  images: string[];
  alt: string;
  device?: "mobile" | "web";
}

const { images, alt, device = "web" } = Astro.props;
const isMobile = device === "mobile";
---

<section aria-labelledby="gallery-heading" class="py-4">
  <h2 id="gallery-heading" class="text-xs font-semibold uppercase tracking-widest text-muted mb-4 flex items-center gap-2">
    <Icon class="size-4 text-primary-500" name="lucide:images" aria-hidden="true" />
    Galería de Imágenes
  </h2>

  <div class="relative">
    <!-- Contenedor del carrusel -->
    <div 
      id="carousel-container"
      class="overflow-x-auto snap-x snap-mandatory flex scroll-smooth
             [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
    >
      {images.map((img, i) => (
        <button
          type="button"
          class:list={[
            "snap-center shrink-0 w-full rounded-xl overflow-hidden cursor-zoom-in",
            "focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500",
            isMobile && "flex items-center justify-center bg-bg-main p-4",
          ]}
          data-lightbox-trigger={i}
          aria-label={`Ver imagen ${i + 1} de ${images.length}: ${alt}`}
        >
          <img
            src={img}
            alt={`${alt} - Imagen ${i + 1}`}
            class={isMobile
              ? "h-[70vh] w-auto max-w-full object-contain rounded-lg shadow-lg"
              : "block w-full h-auto"}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))}
    </div>

    <!-- Flechas de navegación -->
    {images.length > 1 && (
      <>
        <button
          type="button"
          id="carousel-prev"
          class="absolute left-3 top-1/2 -translate-y-1/2 size-10 rounded-full bg-white/80 backdrop-blur-sm
                 flex items-center justify-center shadow-lg border border-border-subtle
                 hover:bg-white hover:shadow-xl transition-all duration-300"
          aria-label="Imagen anterior"
        >
          <Icon class="size-5 text-main" name="lucide:chevron-left" />
        </button>
        <button
          type="button"
          id="carousel-next"
          class="absolute right-3 top-1/2 -translate-y-1/2 size-10 rounded-full bg-white/80 backdrop-blur-sm
                 flex items-center justify-center shadow-lg border border-border-subtle
                 hover:bg-white hover:shadow-xl transition-all duration-300"
          aria-label="Imagen siguiente"
        >
          <Icon class="size-5 text-main" name="lucide:chevron-right" />
        </button>
      </>
    )}

    <!-- Contador de imágenes -->
    <div class="absolute bottom-3 right-3 bg-main/70 backdrop-blur-sm text-white text-xs font-medium px-3 py-1.5 rounded-full" aria-hidden="true">
      <span id="carousel-current">1</span> / {images.length}
    </div>

    <!-- Control de reproducción automática (WCAG 2.2.2) -->
    {images.length > 1 && (
      <button
        type="button"
        id="carousel-autoplay"
        class="absolute bottom-3 left-3 size-9 rounded-full bg-white/80 backdrop-blur-sm flex items-center justify-center shadow-lg border border-border-subtle hover:bg-white hover:shadow-xl transition-all duration-300"
        aria-label="Pausar reproducción automática"
        aria-pressed="false"
      >
        <Icon id="carousel-autoplay-pause" class="size-4 text-main" name="lucide:pause" />
        <Icon id="carousel-autoplay-play" class="hidden size-4 text-main" name="lucide:play" />
      </button>
    )}
  </div>

  <!-- Indicadores -->
  {images.length > 1 && (
    <div class="flex justify-center gap-2 mt-4" role="group" aria-label="Ir a una imagen del carrusel">
      {images.map((_, i) => (
        <button
          type="button"
          class:list={[
            "size-2 rounded-full transition-all duration-300",
            i === 0 ? "bg-primary-500 w-6" : "bg-border-subtle hover:bg-muted"
          ]}
          data-carousel-indicator={i}
          aria-current={i === 0 ? "true" : undefined}
          aria-label={`Ir a imagen ${i + 1} de ${images.length}`}
        />
      ))}
    </div>
  )}
</section>

<!-- Lightbox -->
<div
  id="lightbox-overlay"
  class="fixed inset-0 z-50 bg-black/95 hidden items-center justify-center p-4 cursor-zoom-out w-full h-dvh"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de imagen ampliada"
>
  <button
    type="button"
    id="lightbox-close"
    class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors p-2 rounded-full hover:bg-white/10 z-10"
    aria-label="Cerrar visor de imagen"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <img
    id="lightbox-image"
    src=""
    alt=""
    class="max-w-full max-h-full object-contain rounded-lg"
  />
</div>

<script>
  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initCarousel() {
    const container = document.getElementById("carousel-container") as HTMLDivElement | null;
    const indicators = document.querySelectorAll<HTMLButtonElement>("[data-carousel-indicator]");
    const triggers = document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]");
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const counter = document.getElementById("carousel-current");
    const lightbox = document.getElementById("lightbox-overlay") as HTMLDivElement | null;
    const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
    const lightboxClose = document.getElementById("lightbox-close") as HTMLButtonElement | null;
    const autoplayBtn = document.getElementById("carousel-autoplay") as HTMLButtonElement | null;
    const autoplayPauseIcon = document.getElementById("carousel-autoplay-pause");
    const autoplayPlayIcon = document.getElementById("carousel-autoplay-play");

    if (!container || !lightbox || !lightboxImage) return;
    // Evita la doble inicialización en la primera carga (init directo + astro:page-load)
    if (container.dataset.carouselReady === "true") return;
    container.dataset.carouselReady = "true";

    const totalImages = container.children.length;
    let currentIndex = 0;
    let autoplayInterval: ReturnType<typeof setInterval> | undefined;
    let resumeTimeout: ReturnType<typeof setTimeout> | undefined;
    let autoplayEnabled = !prefersReducedMotion();

    const AUTOPLAY_DELAY = 4000;
    const RESUME_DELAY = 8000;

    const syncIndicators = (index: number) => {
      indicators.forEach((indicator, i) => {
        const active = i === index;
        indicator.classList.toggle("bg-primary-500", active);
        indicator.classList.toggle("w-6", active);
        indicator.classList.toggle("bg-border-subtle", !active);
        if (active) indicator.setAttribute("aria-current", "true");
        else indicator.removeAttribute("aria-current");
      });
    };

    const updateCounter = (index: number) => {
      if (counter) counter.textContent = String(index + 1);
    };

    const goToSlide = (index: number) => {
      if (index < 0) index = totalImages - 1;
      if (index >= totalImages) index = 0;

      currentIndex = index;
      const itemWidth = container.scrollWidth / totalImages;
      container.scrollTo({
        left: itemWidth * index,
        behavior: prefersReducedMotion() ? "auto" : "smooth",
      });
      updateCounter(index);
      syncIndicators(index);
    };

    const clearAutoplay = () => {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = undefined;
      }
    };

    const startAutoplay = () => {
      clearAutoplay();
      if (totalImages <= 1 || !autoplayEnabled) return;
      autoplayInterval = setInterval(() => goToSlide(currentIndex + 1), AUTOPLAY_DELAY);
    };

    const stopAutoplay = () => {
      clearAutoplay();
      if (resumeTimeout) {
        clearTimeout(resumeTimeout);
        resumeTimeout = undefined;
      }
    };

    // Pausa el autoplay y lo reanuda sólo tras un periodo de inactividad,
    // así el tiempo no avanza mientras el usuario interactúa.
    const pauseAutoplay = (resumeDelay = RESUME_DELAY) => {
      stopAutoplay();
      if (totalImages <= 1) return;
      resumeTimeout = setTimeout(() => {
        resumeTimeout = undefined;
        startAutoplay();
      }, resumeDelay);
    };

    const setAutoplayUI = () => {
      if (!autoplayBtn) return;
      autoplayBtn.setAttribute("aria-pressed", String(autoplayEnabled));
      autoplayBtn.setAttribute(
        "aria-label",
        autoplayEnabled ? "Pausar reproducción automática" : "Reanudar reproducción automática",
      );
      autoplayPauseIcon?.classList.toggle("hidden", !autoplayEnabled);
      autoplayPlayIcon?.classList.toggle("hidden", autoplayEnabled);
    };

    autoplayBtn?.addEventListener("click", () => {
      autoplayEnabled = !autoplayEnabled;
      stopAutoplay();
      if (autoplayEnabled) startAutoplay();
      setAutoplayUI();
    });

    prevBtn?.addEventListener("click", () => {
      pauseAutoplay();
      goToSlide(currentIndex - 1);
    });

    nextBtn?.addEventListener("click", () => {
      pauseAutoplay();
      goToSlide(currentIndex + 1);
    });

    indicators.forEach((indicator, i) => {
      indicator.addEventListener("click", () => {
        pauseAutoplay();
        goToSlide(i);
      });
    });

    // Detectar cambio manual por touch/scroll
    container.addEventListener("scroll", () => {
      const itemWidth = container.scrollWidth / totalImages;
      const newIndex = Math.round(container.scrollLeft / itemWidth);
      if (newIndex !== currentIndex) {
        currentIndex = newIndex;
        updateCounter(currentIndex);
        syncIndicators(currentIndex);
      }
    });

    // Pausar autoplay al hover, foco o mientras se presiona/arrastra
    container.addEventListener("mouseenter", stopAutoplay);
    container.addEventListener("mouseleave", startAutoplay);
    container.addEventListener("focusin", stopAutoplay);
    container.addEventListener("focusout", startAutoplay);
    container.addEventListener("pointerdown", stopAutoplay);
    container.addEventListener("pointerup", () => pauseAutoplay());
    container.addEventListener("pointercancel", () => pauseAutoplay());

    // Lightbox con gestión de foco (WCAG 2.4.3)
    let lastFocused: HTMLElement | null = null;

    const getFocusable = () =>
      Array.from(
        lightbox.querySelectorAll<HTMLElement>(
          'button, [href], [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute("disabled"));

    const openLightbox = (trigger: HTMLButtonElement) => {
      const img = trigger.querySelector("img");
      if (!img) return;
      stopAutoplay();
      lastFocused = document.activeElement as HTMLElement | null;
      lightboxImage.src = img.src;
      lightboxImage.alt = img.alt;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      const focusable = getFocusable();
      (focusable[0] ?? lightboxClose)?.focus();
    };

    const closeLightbox = () => {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
      lastFocused?.focus?.();
      lastFocused = null;
      startAutoplay();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => openLightbox(trigger));
    });

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === lightboxClose) closeLightbox();
    });

    lightboxClose?.addEventListener("click", closeLightbox);

    // Escape para cerrar + trampa de foco (Tab) dentro del diálogo
    const onKeydown = (e: KeyboardEvent) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") {
        closeLightbox();
        return;
      }
      if (e.key === "Tab") {
        const focusable = getFocusable();
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    document.addEventListener("keydown", onKeydown);
    document.addEventListener(
      "astro:before-swap",
      () => {
        document.removeEventListener("keydown", onKeydown);
        clearAutoplay();
      },
      { once: true },
    );

    setAutoplayUI();
    startAutoplay();
  }

  document.addEventListener("astro:page-load", initCarousel);
</script>
