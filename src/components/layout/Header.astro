---
import { Icon } from "astro-icon/components";

interface navItem {
  label: string;
  url: string;
  hash: string;
  icon?: ChildNode;
}

export const NAV_ITEMS: navItem[] = [
  {
    label: "Inicio",
    url: "/",
    hash: ""
  },
  {
    label: "Proyectos",
    url: "/",
    hash: "projects"
  },
  {
    label: "Workflow",
    url: "/",
    hash: "workflow"
  },
  {
    label: "Habilidades",
    url: "/",
    hash: "skills"
  },
  {
    label: "Sobre Mi",
    url: "/",
    hash: "about"
  },
  {
    label: "Contacto",
    url: "/",
    hash: "contact"
  }
]

---

<header class="fixed inset-0 top-0 w-full z-50 h-16 flex items-center">
  <div class="flex items-center justify-between max-w-7xl mx-auto w-full px-4 md:px-8">
    <a href="/" class="flex items-center" aria-label="Orlando López — ir al inicio">
      <img data-header-img src="/logo.svg" class="size-14" alt="" aria-hidden="true" loading="eager" />
    </a>

    {/* Navegación de escritorio */}
    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="nav-list flex items-center gap-2">
        {NAV_ITEMS.map(({ label, url, hash }) => {
          const href = hash ? `${url}#${hash}` : url;
          return (
            <li class="nav-item relative">
              <a class="nav-link px-2 text-muted font-semibold hover:text-primary-500 hover:tracking-wider transition-all duration-300" href={href}>{label}</a>
              <span class="nav-indicator absolute -bottom-1.5 left-0 w-0 h-1 rounded-full bg-primary-500 transition-all duration-300" aria-hidden="true"></span>
            </li>
          );
        })}
      </ul>
    </nav>

    {/* Botón del menú móvil */}
    <button
      id="menu-toggle"
      type="button"
      class="md:hidden inline-flex items-center justify-center size-11 rounded-xl text-main hover:text-primary-500 transition-colors"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <Icon name="lucide:menu" class="size-6" data-menu-icon="open" aria-hidden="true" />
      <Icon name="lucide:x" class="size-6" data-menu-icon="close" aria-hidden="true" style="display:none" />
    </button>
  </div>

  {/* Menú móvil (menor a md) */}
  <nav
    id="mobile-nav-menu"
    aria-label="Navegación móvil"
    class="mobile-nav-menu absolute top-16 right-8 z-50 w-56 origin-top-right rounded-2xl border border-border-subtle bg-white/95 backdrop-blur-md shadow-xl p-2 md:hidden"
    hidden
  >
    <ul class="flex flex-col">
      {NAV_ITEMS.map(({ label, url, hash }) => {
        const href = hash ? `${url}#${hash}` : url;
        return (
          <li>
            <a
              class="mobile-nav-link block rounded-xl px-4 py-3 text-sm font-semibold text-muted hover:bg-primary-50 hover:text-primary-500 transition-colors"
              href={href}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  .mobile-nav-link[aria-current="true"] {
    background-color: var(--color-primary-50);
    color: var(--color-primary-500);
  }

  /* Con movimiento reducido no hay animación de scroll: el header mantiene
     su fondo translúcido de forma estática para garantizar legibilidad. */
  @media (prefers-reduced-motion: reduce) {
    header {
      backdrop-filter: blur(12px);
      background-color: rgba(255, 255, 255, 0.65);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from "@/utils/gsap"
  import { $, $$ } from "@/utils/dom"
  import { animateFrom } from "gsap-presets-kit"

  // 1. LÓGICA DE NAVEGACIÓN ACTIVA (SCROLL + PATHNAME)
  const initActiveNav = (signal?: AbortSignal) => {
    const isHomePage = window.location.pathname === "/" || window.location.pathname === "";
    const isProjectSubpage = window.location.pathname.startsWith("/project");
    let activeSectionId = "inicio";

    const updateActiveLink = (targetId?: string) => {
      const $links = $$<HTMLAnchorElement>(".nav-link, .mobile-nav-link");
      const $indicators = $$<HTMLSpanElement>(".nav-indicator");

      $links.forEach((link, index) => {
        const href = link.getAttribute("href") || "";
        const linkHash = href.includes("#") ? href.split("#")[1] : "";
        let isMatch = false;

        if (isProjectSubpage) {
          isMatch = linkHash === "projects";
        } else if (isHomePage) {
          const currentId = targetId || activeSectionId;
          isMatch = linkHash === currentId || (linkHash === "" && (currentId === "inicio" || currentId === ""));
        } else {
          isMatch = linkHash === "" || linkHash === "inicio";
        }

        // 0. Estado activo para lectores de pantalla
        if (isMatch) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");

        // 1. Alternar color del texto del enlace
        link.classList.toggle("text-primary-500", isMatch);
        link.classList.toggle("tracking-wider", isMatch);
        link.classList.toggle("text-muted", !isMatch);
        link.classList.toggle("tracking-normal", !isMatch);

        // 2. Controlar la barra indicadora según el índice
        const indicator = $indicators[index];
        if (indicator) {
          indicator.classList.toggle("w-full", isMatch);
          indicator.classList.toggle("w-0", !isMatch);
        }
      });
    };

    if (isHomePage) {
      const $links = $$<HTMLAnchorElement>(".nav-link");
      const sections = $links
        .map((link) => {
          const href = link.getAttribute("href") || "";
          const hash = href.includes("#") ? href.split("#")[1] : "inicio";
          return document.getElementById(hash);
        })
        .filter((section): section is HTMLElement => section !== null);

      if (sections.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                activeSectionId = entry.target.id;
                updateActiveLink(activeSectionId);
              }
            });
          },
          {
            rootMargin: "-20% 0px -60% 0px",
            threshold: 0,
          }
        );

        sections.forEach((section) => observer.observe(section));
        signal?.addEventListener("abort", () => observer.disconnect());
      }
    }

    // Desplazamiento suave al tope absoluto (0, 0) al pulsar "Inicio" o el Logo estando en la home
    const $homeLinks = document.querySelectorAll<HTMLAnchorElement>("a[href='/'], a[href='/#inicio'], a[href='#inicio']");
    $homeLinks.forEach((link) => {
      link.addEventListener(
        "click",
        (e) => {
          if (window.location.pathname === "/" || window.location.pathname === "") {
            e.preventDefault();
            window.scrollTo({
              top: 0,
              behavior: prefersReducedMotion() ? "auto" : "smooth",
            });
            history.pushState(null, "", "/");
            activeSectionId = "inicio";
            updateActiveLink("inicio");
          }
        },
        { signal },
      );
    });

    updateActiveLink();
    window.addEventListener(
      "hashchange",
      () => {
        const hash = window.location.hash.replace("#", "");
        if (hash) {
          activeSectionId = hash;
          updateActiveLink(hash);
        }
      },
      { signal },
    );
  };

  const tl = gsap.timeline()

  // 2. LÓGICA DE ANIMACIÓN DE ENTRADA (GSAP)
  const initAnimations = () => {
    if (prefersReducedMotion()) return

    animateFrom("[data-header-img]",
    {
      opacity: 0,
      x: -30,
      y: 0,
      duration: 0.4,
      ease: "back.out",
      delay: 0.2,
      timeline: tl
    })

    animateFrom(".nav-item",
    {
      opacity: 0,
      y: 30,
      duration: 0.5,
      ease: "back.out",
      stagger: 0.05,
      timeline: tl
    })
  }
  
  // 3. LÓGICA DE BLUR + SOMBRA AL HACER SCROLL (GSAP)
  const initHeaderScroll = (signal?: AbortSignal) => {
    const header = document.querySelector("header");
    // Sin animación: el fondo del header se aplica por CSS (ver <style>)
    if (!header || prefersReducedMotion()) return;

    gsap.set(header, {
      backdropFilter: "blur(0px)",
      backgroundColor: "rgba(255, 255, 255, 0)",
      boxShadow: "0 0 0 rgba(0, 0, 0, 0)",
    });

    const tween = gsap.to(header, {
      backdropFilter: "blur(12px)",
      backgroundColor: "rgba(255, 255, 255, 0.65)",
      boxShadow: "0 4px 20px rgba(0, 0, 0, 0.08)",
      duration: 0.4,
      ease: "power1.out",
      scrollTrigger: {
        trigger: document.body,
        start: "top -10",
        toggleActions: "play none none reverse",
      },
    });

    signal?.addEventListener("abort", () => {
      tween.scrollTrigger?.kill();
      tween.kill();
    });
  }

  // 4. LÓGICA DEL MENÚ MÓVIL (< md)
  const initMobileMenu = (signal?: AbortSignal) => {
    const toggle = $<HTMLButtonElement>("#menu-toggle");
    const menu = $<HTMLElement>("#mobile-nav-menu");
    if (!toggle || !menu) return;

    const iconOpen = $<SVGSVGElement>('[data-menu-icon="open"]', toggle);
    const iconClose = $<SVGSVGElement>('[data-menu-icon="close"]', toggle);
    const items = $$<HTMLAnchorElement>(".mobile-nav-link", menu);
    const desktopQuery = window.matchMedia("(min-width: 48rem)");

    let isOpen = false;
    let menuTl: gsap.core.Timeline | undefined;

    const getTimeline = () => {
      if (menuTl) return menuTl;

      menuTl = gsap
        .timeline({
          paused: true,
          onReverseComplete: () => {
            menu.hidden = true;
          },
        })
        .fromTo(
          menu,
          { opacity: 0, y: -12, scale: 0.96 },
          { opacity: 1, y: 0, scale: 1, duration: 0.25, ease: "power2.out" },
        )
        .fromTo(
          items,
          { opacity: 0, y: -8 },
          {
            opacity: 1,
            y: 0,
            duration: 0.2,
            stagger: 0.04,
            ease: "power2.out",
          },
          "-=0.12",
        );

      return menuTl;
    };

    const open = () => {
      if (isOpen) return;
      isOpen = true;
      menu.hidden = false;
      getTimeline().play(0);
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú de navegación");
      if (iconOpen) iconOpen.style.display = "none";
      if (iconClose) iconClose.style.display = "";
    };

    const close = () => {
      if (!isOpen) return;
      isOpen = false;
      getTimeline().reverse();
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú de navegación");
      if (iconOpen) iconOpen.style.display = "";
      if (iconClose) iconClose.style.display = "none";
    };

    toggle.addEventListener("click", () => (isOpen ? close() : open()));
    items.forEach((item) => item.addEventListener("click", close));

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") close();
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        if (!isOpen) return;
        const target = event.target as Node;
        if (!menu.contains(target) && !toggle.contains(target)) close();
      },
      { signal },
    );

    desktopQuery.addEventListener(
      "change",
      (event) => {
        if (event.matches) close();
      },
      { signal },
    );
  };

  // INICIALIZACIÓN CENTRALIZADA CON LIMPIEZA ENTRE NAVEGACIONES
  let controller: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    initActiveNav(signal);
    initAnimations();
    initHeaderScroll(signal);
    initMobileMenu(signal);
  });

  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>