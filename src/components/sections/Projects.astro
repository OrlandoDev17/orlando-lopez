---
import SectionContainer from "@/components/common/SectionContainer.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { ProjectsData } from "@/constants/projects";
---

<SectionContainer
  id="projects"
  title="Experiencia & Proyectos"
  subtitle="Una coleccion de aplicaciones enfocadas en rendimiento, interfaces intuitivas y código escalable. Cada proyecto representa un desafío técnico resuelto desde el diseño hasta la implementación."
  titleId="projects-title"
  subtitleId="projects-paragraph"
  separatorId="projects-separator"
>
  <div class="flex flex-col gap-6 w-full">
    {ProjectsData.map((project) => (
      <div class="project-card">
        <ProjectCard {...project} />
      </div>
    ))}
  </div>
</SectionContainer>

<script>
  import { animateFrom, splitTextReveal } from "gsap-presets-kit"
  import { createSectionTimeline } from "@/utils/gsap"

  const tl = createSectionTimeline("#projects")

  const initProjectsAnimations = () => {
    splitTextReveal("#projects-title", {
      type: "words",
      opacity: 0,
      y: 30,
      stagger: 0.15,
      duration: 0.4,
      ease: "power2.out",
      timeline: tl,
      scroll: false,
    })

    animateFrom("#projects-paragraph", {
      opacity: 0,
      x: -30,
      duration: 0.3,
      ease: "back.out",
      timeline: tl,
      position: "-=0.2",
      scroll: false
    })

    tl.from("#projects-separator", {
      scaleX: 0,
      transformOrigin: "left center",
      duration: 0.4,
      ease: "power2.out",
    }, "-=0.3")

    animateFrom(".project-card", {
      opacity: 0,
      y: 30,
      duration: 0.3,
      ease: "power3.out",
      timeline: tl,
      scroll: false,
      stagger: 0.2,
      position: "-=0.1"
    })

  }

  document.addEventListener("astro:page-load", () => {
    initProjectsAnimations()
  })
</script>
