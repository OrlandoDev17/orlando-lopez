---
import SectionContainer from "@/components/common/SectionContainer.astro";
import { Icon } from "astro-icon/components";
import { workflowSteps } from "@/constants/workflow";

const totalSteps = String(workflowSteps.length).padStart(2, "0");

const CARD_ROTATIONS = [
  "rotate-[-2deg]",
  "rotate-[1.5deg]",
  "rotate-[1deg]",
  "rotate-[-1.5deg]",
  "rotate-[2deg]",
  "rotate-[-1deg]",
];

const CARD_RADII = [
  "rounded-[28px_20px_32px_24px]",
  "rounded-[22px_30px_24px_32px]",
  "rounded-[30px_24px_20px_28px]",
  "rounded-[24px_32px_28px_20px]",
  "rounded-[20px_28px_32px_24px]",
  "rounded-[32px_20px_28px_24px]",
];
---

<SectionContainer id="workflow" aria-label="Mi flujo de trabajo">
  <div>
    <div
      id="workflow-pin"
      class="relative z-30 flex flex-col justify-center gap-5 md:h-dvh 2xl:gap-8 overflow-hidden"
    >
      {/* Header */}
      <header class="flex flex-col gap-2">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
          <h2 id="workflow-title" class="text-3xl text-primary-500 font-black">
            Mi Flujo de Trabajo
          </h2>

          {/* Indicador de progreso */}
          <div
            id="workflow-progress"
            class="hidden md:flex shrink-0 flex-col items-end gap-2"
          >
            <span
              class="inline-flex items-baseline gap-1.5 bg-white/80 backdrop-blur-sm border border-border-subtle shadow-sm rounded-full px-4 py-1.5 font-heading"
            >
              <span
                id="workflow-progress-step"
                class="inline-block text-sm font-black text-primary-600"
              >
                01
              </span>
              <span class="text-xs font-medium text-muted">/ {totalSteps}</span>
            </span>
            <div
              class="w-36 h-1.5 rounded-full bg-border-subtle overflow-hidden"
              aria-hidden="true"
            >
              <div
                id="workflow-progress-bar"
                class="h-full w-full origin-left rounded-full bg-linear-to-r from-primary-500 to-secondary-500"
              >
              </div>
            </div>
          </div>
        </div>

        <p id="workflow-paragraph" class="text-sm text-muted font-body max-w-2xl">
          Un vistazo a mi proceso de desarrollo de software, desde la ideación
          hasta el despliegue.
        </p>
        <div
          id="workflow-separator"
          class="w-md h-1.5 rounded-full bg-secondary-500 my-1"
        />
      </header>

      {/* Pista horizontal */}
      <div class="relative">
        {/* Línea vertical (móvil) */}
        <div
          class="absolute left-1.5 top-2 bottom-2 w-1.5 rounded-full bg-linear-to-b from-primary-500 via-primary-700 to-secondary-500 shadow-[0_0_8px_rgba(122,92,250,0.4)] md:hidden"
          aria-hidden="true"
        >
        </div>

        <svg
          class="hidden md:block absolute top-1/2 left-0 w-full -translate-y-1/2 pointer-events-none z-0"
          height="280"
          viewBox="0 0 1200 280"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            id="workflow-svg-line"
            d="M 0,140 Q 300,20 600,140 T 1200,140"
            fill="none"
            stroke="url(#workflow-gradient-line)"
            stroke-width="8"
            stroke-linecap="round"
            stroke-dasharray="1308"
            stroke-dashoffset="1308"
          />
          <defs>
            <linearGradient
              id="workflow-gradient-line"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="0%"
            >
              <stop offset="0%" stop-color="#7a5cfa" />
              <stop offset="50%" stop-color="#6340e3" />
              <stop offset="100%" stop-color="#a3e862" />
            </linearGradient>
          </defs>
        </svg>

        <div
          id="workflow-track"
          class="relative z-10 flex flex-col items-center gap-6 w-full pl-8 md:flex-row md:gap-0 md:w-max md:h-[min(55vh,26rem)] md:min-h-80 md:pl-0 md:pr-25"
        >
          {workflowSteps.map((step, index) => (
            <div class="workflow-card w-full min-w-0 h-auto flex items-center justify-center md:w-[45vw] md:min-w-95 md:h-full md:px-6">
              <article
                class:list={[
                  "workflow-step-card group/step relative max-w-xl w-full p-6 2xl:p-8 shadow-md overflow-hidden",
                  "transition-[translate,scale,rotate,box-shadow] duration-300 ease-out",
                  "hover:rotate-0 hover:-translate-y-2 hover:scale-[1.03] hover:shadow-[0_24px_48px_rgba(122,92,250,0.25)]",
                  CARD_ROTATIONS[index % CARD_ROTATIONS.length],
                  CARD_RADII[index % CARD_RADII.length],
                ]}
              >
                {/* Acento decorativo */}
                <div
                  class="absolute top-0 left-0 w-1.5 h-full origin-bottom scale-y-100 bg-linear-to-b from-primary-500 to-primary-700 transition-all duration-300 group-hover/step:scale-y-110 group-hover/step:from-secondary-500 group-hover/step:to-primary-500"
                  aria-hidden="true"
                >
                </div>

                {/* Encabezado del Card */}
                <div class="flex items-center gap-3 mb-4 2xl:mb-6">
                  <span
                    class="inline-flex items-center justify-center size-10 2xl:size-12 shrink-0 rounded-xl text-white shadow-md shadow-primary-500/25 bg-linear-to-br from-primary-500 to-secondary-500 transition-transform duration-300 group-hover/step:scale-110 group-hover/step:-rotate-6"
                    aria-hidden="true"
                  >
                    <Icon name={step.icon} class="size-6" />
                  </span>
                  <span class="text-3xl 2xl:text-4xl font-black text-primary-500 transition-colors duration-300 group-hover/step:text-secondary-600">
                    {step.number}
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wider bg-primary-50 text-primary-700 px-3 py-1 rounded-full border border-primary-200">
                    {step.category}
                  </span>
                </div>

                {/* Titulo & Descripcion */}
                <h3 class="text-xl 2xl:text-2xl font-bold text-main mb-2 2xl:mb-3 transition-colors duration-300 group-hover/step:text-primary-600">
                  {step.title}
                </h3>
                <p class="text-muted text-sm leading-relaxed mb-4 2xl:mb-6">
                  {step.description}
                </p>

                {/* Entregable Clave */}
                <div class="flex items-center justify-between gap-4 border-t border-border-subtle pt-3 2xl:pt-4 mb-4 2xl:mb-5">
                  <span class="inline-flex items-center gap-2 text-muted">
                    <Icon
                      name="lucide:package-check"
                      class="size-4 shrink-0 text-secondary-700"
                      aria-hidden="true"
                    />
                    <span class="text-xs font-medium uppercase tracking-wider">
                      Entregable
                    </span>
                  </span>
                  <span class="flex-1 min-w-0 text-right text-xs font-semibold text-primary-600">
                    {step.deliverable}
                  </span>
                </div>

                {/* Badges de Tecnologias / Herramientas */}
                <div class="flex flex-wrap gap-2">
                  {step.techs.map((tech) => (
                    <span class="text-xs bg-bg-main text-main font-medium px-3 py-1 rounded-md border border-border-subtle transition-all duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:text-primary-700">
                      {tech}
                    </span>
                  ))}
                </div>
              </article>
            </div>
          ))}
        </div>

        {/* Barreras de desvanecimiento: las cards aparecen/desaparecen en los bordes */}
        <div
          class="hidden md:block pointer-events-none absolute -inset-y-4 left-0 z-20 w-20 sm:w-28 lg:w-40 bg-linear-to-r from-bg-main via-bg-main/70 to-transparent"
          aria-hidden="true"
        >
        </div>
        <div
          class="hidden md:block pointer-events-none absolute -inset-y-4 right-0 z-20 w-20 sm:w-28 lg:w-40 bg-linear-to-l from-bg-main via-bg-main/70 to-transparent"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>
</SectionContainer>

<style>
  #workflow-svg-line {
    filter: drop-shadow(0 0 8px rgba(122, 92, 250, 0.4));
  }

  .workflow-step-card {
    border: 1px solid transparent;
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.96))
        padding-box,
      linear-gradient(135deg, rgba(122, 92, 250, 0.5), rgba(163, 232, 98, 0.4))
        border-box;
  }

  .workflow-step-card:hover {
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.99), rgba(255, 255, 255, 0.99))
        padding-box,
      linear-gradient(135deg, rgba(122, 92, 250, 0.85), rgba(163, 232, 98, 0.7))
        border-box;
  }

  @media (max-width: 47.99rem) {
    .workflow-step-card {
      rotate: 0deg;
    }
  }

  /* Movimiento reducido: el pin pasa a ser un carril con scroll horizontal */
  .workflow-reduced {
    overflow-x: auto !important;
    scrollbar-width: none;
  }
  .workflow-reduced::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from "@/utils/gsap";
  import { $$ } from "@/utils/dom";
  import { animateFrom, splitTextReveal } from "gsap-presets-kit";

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | undefined;
  let mm: gsap.MatchMedia | undefined;

  const initWorkflow = () => {
    ctx?.revert();
    mm?.revert();
    ctx = undefined;
    mm = undefined;

    const pin = document.querySelector<HTMLElement>("#workflow-pin");
    const track = document.querySelector<HTMLElement>("#workflow-track");
    const svgLine = document.querySelector<SVGPathElement>(
      "#workflow-svg-line",
    );
    const stepEl = document.querySelector<HTMLElement>(
      "#workflow-progress-step",
    );
    const progressBar = document.querySelector<HTMLElement>(
      "#workflow-progress-bar",
    );

    if (!pin || !track || !svgLine) return;

    // Movimiento reducido: sin pin ni scrub. Se habilita scroll horizontal
    // nativo para que todas las tarjetas sigan siendo accesibles.
    if (prefersReducedMotion()) {
      pin.classList.add("workflow-reduced");
      return;
    }

    const cards = $$(".workflow-card");
    const totalSteps = cards.length;

    const getScrollDistance = () => track.scrollWidth - pin.clientWidth;

    const setBarProgress = progressBar
      ? gsap.quickSetter(progressBar, "scaleX")
      : undefined;

    let currentStep = 1;

    const updateProgress = (progress: number) => {
      setBarProgress?.(progress);
      const next = Math.min(
        totalSteps,
        Math.max(1, Math.round(progress * (totalSteps - 1)) + 1),
      );
      if (next !== currentStep && stepEl) {
        currentStep = next;
        stepEl.textContent = String(next).padStart(2, "0");
        gsap.fromTo(
          stepEl,
          { yPercent: -60, opacity: 0 },
          { yPercent: 0, opacity: 1, duration: 0.35, ease: "back.out" },
        );
      }
    };

    // Reveal de cabecera: igual en todos los breakpoints
    ctx = gsap.context(() => {
      if (progressBar) gsap.set(progressBar, { scaleX: 0 });

      const headerTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#workflow",
          start: "top 85%",
          once: true,
        },
      });

      splitTextReveal("#workflow-title", {
        type: "words",
        opacity: 0,
        y: 30,
        stagger: 0.15,
        duration: 0.6,
        ease: "power2.out",
        timeline: headerTl,
        scroll: false,
      });

      animateFrom("#workflow-paragraph", {
        opacity: 0,
        x: -30,
        duration: 0.5,
        ease: "back.out",
        timeline: headerTl,
        position: "-=0.2",
        scroll: false,
      });

      headerTl.from(
        "#workflow-separator",
        {
          scaleX: 0,
          transformOrigin: "left center",
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.3",
      );
    });

    // Comportamiento responsive
    mm = gsap.matchMedia();

    mm.add(
      {
        isMobile: "(max-width: 47.99rem)",
        isDesktop: "(min-width: 48rem)",
      },
      (context) => {
        const { isMobile } = context.conditions as {
          isMobile: boolean;
          isDesktop: boolean;
        };

        // Móvil: cards apiladas, entrada simple, sin pin ni scroll horizontal
        if (isMobile) {
          gsap.from(cards, {
            opacity: 0,
            y: 40,
            duration: 0.5,
            ease: "power3.out",
            stagger: 0.12,
            scrollTrigger: {
              trigger: track,
              start: "top 85%",
              once: true,
            },
          });

          return;
        }

        // Desktop: scroll horizontal con pin
        const pathLength = svgLine.getTotalLength();

        gsap.set(svgLine, {
          strokeDasharray: pathLength,
          strokeDashoffset: pathLength,
        });

        // Promueve el track a su propia capa durante el desplazamiento horizontal
        gsap.set(track, { willChange: "transform" });

        const scrollTl = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: pin,
            start: "top top",
            end: () => `+=${getScrollDistance()}`,
            scrub: 0.8,
            pin: true,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => updateProgress(self.progress),
          },
        });

        scrollTl.to(track, { x: () => -getScrollDistance() }, 0);
        scrollTl.to(svgLine, { strokeDashoffset: 0 }, 0);

        cards.forEach((wrapper) => {
          const card = wrapper.querySelector(".workflow-step-card");
          if (!card) return;

          gsap.fromTo(
            card,
            { scale: 0.92, opacity: 0.6 },
            {
              scale: 1,
              opacity: 1,
              ease: "none",
              scrollTrigger: {
                trigger: wrapper,
                containerAnimation: scrollTl,
                start: "left 95%",
                end: "center 30%",
                scrub: true,
              },
            },
          );
        });

        updateProgress(0);
      },
    );

    ScrollTrigger.refresh();
  };

  document.addEventListener("astro:page-load", initWorkflow);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    ctx?.revert();
  });

  document.fonts?.ready.then(() => ScrollTrigger.refresh());
</script>
