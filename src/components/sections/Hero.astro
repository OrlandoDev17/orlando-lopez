---
import { HIGHLIGHTED_WORDS } from "@/utils/highlighted-words";
import { highlight } from "@/utils/highlight";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { HERO_DESCRIPTION, TECH_ICONS, TECH_STACK } from "@/components/sections/hero.constants";
---

<section class="w-full grid grid-cols-2 max-w-7xl min-h-screen mx-auto px-8 py-8">
  <div class="flex flex-col gap-4">
    <h1 id="hero-title" class="text-7xl font-black">
      Hola, Soy Orlando López
    </h1>
    <h2 id="hero-subtitle" class="text-4xl text-secondary-600 font-semibold">Desarrollador de Software</h2>
    <p id="hero-description" class="text-muted text-balance max-w-xl" set:html={highlight(HERO_DESCRIPTION, HIGHLIGHTED_WORDS)} />
  </div>
  <aside class="flex items-start justify-center relative">
    <div class="avatar-container relative w-full flex justify-center">
      <Image id="avatar" src="/avatar/avatar.webp" alt="Avatar de Orlando López" width={448} height={448} />
      {TECH_ICONS.map((icon) => (
        <span
          class={`tech-icon absolute`}
          data-top={icon.top}
          data-side={icon.side}
          data-outset={icon.outset}
        >
          <Icon
            name={icon.icon}
            title={icon.label}
            class={icon.className ?? "size-12 text-primary-500"}
          />
        </span>
      ))}
    </div>
  </aside>
</section>

<section
  class="marquee overflow-hidden pb-8 [-webkit-mask-image:linear-gradient(to_right,transparent,black_4%,black_96%,transparent)] mask-image:linear-gradient(to_right,transparent,black_4%,black_96%,transparent)]"
  aria-label="Tecnologías que uso"
>
  <div class="marquee-track flex items-center gap-16">
    {TECH_STACK.map(({ name, icon }) => (
      <span class="flex shrink-0">
        <Icon title={name} name={icon} class="size-14 text-primary-500" />
      </span>
    ))}
  </div>
</section>

<script>
  import gsap from "gsap";
  import { $$ } from "@/utils/dom"
  import { typewriter, splitTextAnimation, animate, animateFromTo, marquee } from "@/utils/animations"

  const initHeroAnimations = () => {

      const $techIcons = $$(".tech-icon")
    if (!$techIcons.length) return

    const tl = gsap.timeline()

    typewriter("#hero-title", {
      highlight: ["Orlando", "López"],
      highlightClass: "text-primary-500",
      speed: 50
    }, tl)

    splitTextAnimation("#hero-subtitle", {
      opacity: 0,
      y: 30,
      stagger: 0.15,
      type: "words",
    }, {}, tl, "-=0.2")

    animate("#hero-description", {
      opacity: 0,
      x: -30,
      duration: 0.5,
      ease: "back.out",
    }, {}, tl, "-=0.2")

    animate("#avatar", {
      opacity: 0,
      y: 30,
      scale: 0.8,
      ease: "back.out",
      duration: 0.5
    }, {}, tl, "-=0.2")

    $techIcons.forEach((el, i) => {
      const isLeft = el.dataset.side === "left"
      const side = isLeft ? "left" : "right"
      const outset = el.dataset.outset === "true"
      
      const from = { top: "50%", scale: 0, opacity: 0, [side]: "50%" }
      const to = { top: el.dataset.top, scale: 1, opacity: 1, [side]: outset ? "5%" : "15%"}
      animateFromTo(el, from, to, { duration: 0.2 }, tl, "-=0.6")
    })
  }

  document.addEventListener("DOMContentLoaded", () => {
    initHeroAnimations()
    marquee(".marquee-track", { speed: 60, direction: "right", pauseOnHover: false })
  });

</script>
